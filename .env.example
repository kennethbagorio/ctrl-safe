# Copy to .env.local for local dev. In Vercel, add each as an Environment Variable.
# Never commit .env.local.

# OpenAI-compatible chat API (Vocareum proxy or https://api.openai.com/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Upstash Vector index — create it WITH a built-in embedding model (e.g. bge-m3)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Retrieval depth (chunks returned per search)
RAG_TOP_K=5

# Embedding model served through the same OpenAI-compatible endpoint
EMBEDDING_MODEL=text-embedding-3-small

# Evaluation harness (stretch goal) — https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=
# Only if your LangSmith workspace is not in the US region (copy from Settings)
# LANGSMITH_ENDPOINT=
LANGSMITH_DATASET=ctrl-safe-eval
